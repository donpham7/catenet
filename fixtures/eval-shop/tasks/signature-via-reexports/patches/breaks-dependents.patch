+const SYMBOLS: Record<string, string> = { USD: "$", EUR: "€" };
+
+export interface PriceOptions {
+  currency: string;
+}
+
+export function formatPrice(amount: number, options: PriceOptions): string {
+  const symbol = options?.currency ? SYMBOLS[options.currency] : undefined;
+  if (!symbol) throw new Error(`unsupported currency: ${String(options?.currency)}`);
+  return `${symbol}${roundCents(amount).toFixed(2)}`;
 }
 
